{
  "info": {
    "name": "AgroAPI-Llontop-Vivas - Examen Unidad 2",
    "description": "AgroSierra · Unidad 2. Ejecutar los logins y luego las peticiones numeradas. Pruebas 400, 401, 403, 409 y DELETE 204. El emulador Android usa 10.0.2.2, Postman en Windows usa localhost.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "tokenTecnico",
      "value": ""
    },
    {
      "key": "tokenJefe",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenSupervisor",
      "value": ""
    },
    {
      "key": "laborCreadaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login técnico (200)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"tecnico1\",\n  \"contrasena\": \"Agro2026*\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) pm.collectionVariables.set('tokenTecnico', pm.response.json().token);"
            ]
          }
        }
      ]
    },

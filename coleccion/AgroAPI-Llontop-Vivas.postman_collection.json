{
  "info": {
    "name": "AgroAPI-Llontop-Vivas - Examen Unidad 2",
    "description": "Peticiones de demostración AgroSierra. Ejecutar Login técnico y Login jefe para guardar tokens antes de los casos protegidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080/api/v1"},
    {"key": "tokenTecnico", "value": ""},
    {"key": "tokenJefe", "value": ""},
    {"key": "tokenAdmin", "value": ""}
  ],
  "item": [
    {
      "name": "01 Login técnico (200)",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/auth/login", "body": {"mode": "raw", "raw": "{\"usuario\":\"tecnico1\",\"contrasena\":\"Agro2026*\"}"}},
      "event": [{"listen": "test", "script": {"exec": ["if (pm.response.code === 200) pm.collectionVariables.set('tokenTecnico', pm.response.json().token);"]}}]
    },
    {
      "name": "02 Login jefe (200)",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/auth/login", "body": {"mode": "raw", "raw": "{\"usuario\":\"jefe1\",\"contrasena\":\"Agro2026*\"}"}},
      "event": [{"listen": "test", "script": {"exec": ["if (pm.response.code === 200) pm.collectionVariables.set('tokenJefe', pm.response.json().token);"]}}]
    },
    {
      "name": "03 Login administrador (200)",
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/auth/login", "body": {"mode": "raw", "raw": "{\"usuario\":\"admin\",\"contrasena\":\"Agro2026*\"}"}},
      "event": [{"listen": "test", "script": {"exec": ["if (pm.response.code === 200) pm.collectionVariables.set('tokenAdmin', pm.response.json().token);"]}}]
    },
    {
      "name": "04 Sin token (401)",
      "request": {"method": "GET", "url": "{{baseUrl}}/lotes"}
    },
    {
      "name": "05 Token alterado (401)",
      "request": {"method": "GET", "url": "{{baseUrl}}/lotes",
        "header": [{"key": "Authorization", "value": "Bearer token-falso"}]}
    },
    {
      "name": "06 Listar lotes filtrados (200)",
      "request": {"method": "GET", "url": "{{baseUrl}}/lotes?pagina=0&tamanio=5&valle=Mantaro&estado=ABIERTA",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenTecnico}}"}]}
    },
    {
      "name": "07 Detalle de lote (200)",
      "request": {"method": "GET", "url": "{{baseUrl}}/lotes/4",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenTecnico}}"}]}
    },
    {
      "name": "08 Labores de lote (200)",
      "request": {"method": "GET", "url": "{{baseUrl}}/lotes/4/labores?pagina=0&tamanio=20",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenTecnico}}"}]}
    },
    {
      "name": "09 Crear labor (201)",
      "request": {"method": "POST", "url": "{{baseUrl}}/labores",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenTecnico}}"}, {"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"loteId\":4,\"tipo\":\"RIEGO\",\"fecha\":\"2026-10-27\",\"cantidad\":1,\"observacion\":\"Riego desde Postman\"}"}},
      "event": [{"listen": "test", "script": {"exec": ["if (pm.response.code === 201) pm.collectionVariables.set('laborCreadaId', pm.response.json().id);"]}}]
    },
    {
      "name": "10 Editar labor propia (200)",
      "request": {"method": "PUT", "url": "{{baseUrl}}/labores/{{laborCreadaId}}",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenTecnico}}"}, {"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"tipo\":\"RIEGO\",\"fecha\":\"2026-10-27\",\"cantidad\":1.5,\"observacion\":\"Corrección antes de 24 horas\"}"}}
    },
    {
      "name": "11 Usuario actual (200)",
      "request": {"method": "GET", "url": "{{baseUrl}}/usuarios/me",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenTecnico}}"}]}
    },
    {
      "name": "12 Administrador sin privilegio LABOR_CREAR (403)",
      "request": {"method": "POST", "url": "{{baseUrl}}/labores",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenAdmin}}"}, {"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"loteId\":4,\"tipo\":\"RIEGO\",\"fecha\":\"2026-10-27\",\"cantidad\":1,\"observacion\":\"No autorizado\"}"}}
    },
    {
      "name": "13 Fumigación excesiva RN-04 (400)",
      "request": {"method": "POST", "url": "{{baseUrl}}/labores",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenTecnico}}"}, {"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"loteId\":4,\"tipo\":\"FUMIGACION\",\"fecha\":\"2026-10-27\",\"cantidad\":100,\"observacion\":\"Excede la dosis\"}"}}
    },
    {
      "name": "14 Labor sobre campaña cerrada RN-01 (409)",
      "request": {"method": "POST", "url": "{{baseUrl}}/labores",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenTecnico}}"}, {"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\"loteId\":1,\"tipo\":\"RIEGO\",\"fecha\":\"2026-10-27\",\"cantidad\":1,\"observacion\":\"Cerrada\"}"}}
    },
    {
      "name": "15 Cerrar sin cosecha RN-03 (409)",
      "request": {"method": "POST", "url": "{{baseUrl}}/lotes/4/cerrar-campania",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenJefe}}"}]}
    },
    {
      "name": "16 Borrar labor (204, sin cuerpo)",
      "request": {"method": "DELETE", "url": "{{baseUrl}}/labores/{{laborCreadaId}}",
        "header": [{"key": "Authorization", "value": "Bearer {{tokenJefe}}"}]}
    }
  ]
}
